PORT=3000
NODE_ENV=development
VERSION=1.0.0

# ---------------------------------------------------------------------------
# Gateway master secret (RECOMMENDED for production).
# Used by the EncryptionService to encrypt provider credentials at rest. This
# is a GATEWAY secret — it is NOT a provider API key. When unset, a
# process-local key is generated (credentials won't survive a restart).
# GATEWAY_SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# LEGACY single-provider demo endpoint (/api/v1/generate) — OPTIONAL.
# These are NOT required for startup. The Gateway starts with them unset;
# provider credentials are configured via the Dashboard / ConnectionManager.
# Only set these if you use the legacy /api/v1/generate route.
# MODELS_LIST=[{"id":"deepseek-v4-flash","object":"model"}]
# AI_API_URL=https://api.deepseek.com/v1/chat/completions
# AI_API_KEY=your-api-key-here
# AI_MODEL=deepseek-v4-flash


# Provider Manager
# Directory containing provider JSON config files (defaults to config/providers)
PROVIDERS_CONFIG_DIR=config/providers

# Provider credentials — ALL OPTIONAL. The Gateway starts with NONE of these
# set. Provider credentials are normally configured through the Dashboard /
# ConnectionManager (encrypted at rest). These env vars remain supported only
# for backward-compatible ${VAR} placeholders inside provider config files —
# if a var is unset, that provider is simply auto-disabled at startup (the
# Gateway still starts and other providers/connections keep working).
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# TOKENFAUCET_API_KEY=your-tokenfaucet-api-key-here
# DATABRICKS_TOKEN=your-databricks-token-here
# NVIDIA_API_KEY=your-nvidia-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Gateway Authentication
# When API keys are configured, every endpoint except /, /health, /ready
# requires a valid Bearer token. When no keys are configured, the gateway
# runs in open mode (no auth).
#
# Option 1: JSON file (see config/apiKeys.example.json)
# Copy it to config/apiKeys.json and edit:
#   cp config/apiKeys.example.json config/apiKeys.json
# API_KEYS_CONFIG_FILE=config/apiKeys.json
#
# Option 2: Environment variable (JSON array or comma-separated)
# GATEWAY_API_KEYS=["sk-my-key-1","sk-my-key-2"]
# GATEWAY_API_KEYS=sk-my-key-1,sk-my-key-2

# Rate Limiting & Quota Management
# When disabled (default), no rate limiting is applied.
# Copy config/rateLimit.example.json to config/rateLimit.json and edit:
#   cp config/rateLimit.example.json config/rateLimit.json
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_ALGORITHM=token_bucket
# RATE_LIMIT_GLOBAL_RPM=1000
# RATE_LIMIT_GLOBAL_BURST=100
# RATE_LIMIT_GLOBAL_CONCURRENT=50
# RATE_LIMIT_PER_KEY_RPM=100
# RATE_LIMIT_PER_KEY_BURST=20
# RATE_LIMIT_PER_KEY_CONCURRENT=10
# RATE_LIMIT_PER_KEY_DAILY_REQUESTS=10000
# RATE_LIMIT_PER_KEY_DAILY_TOKENS=1000000
# RATE_LIMIT_PER_KEY_MONTHLY_TOKENS=30000000
# RATE_LIMIT_PER_PROVIDER_RPM=500
# RATE_LIMIT_PER_PROVIDER_BURST=50
# RATE_LIMIT_PER_PROVIDER_CONCURRENT=20
# RATE_LIMIT_PER_MODEL_RPM=200
# RATE_LIMIT_PER_MODEL_BURST=20

# Routing Strategy (Sprint 9 — Multi-Provider Gateway)
# Copy config/routing.example.json to config/routing.json and edit, or set env vars.
#   cp config/routing.example.json config/routing.json
# Provider routing strategy: priority | fastest-response | lowest-latency |
#   round-robin | least-used | weighted | random
# ROUTING_STRATEGY=priority
# Connection routing strategy (Dashboard connections/accounts):
#   priority | round-robin | least-used | weighted | random | fastest-response
# ROUTING_CONNECTION_STRATEGY=priority
# Key selection strategy (default for all providers): priority | round-robin |
#   random | least-used | weighted
# ROUTING_KEY_SELECTION_STRATEGY=round-robin
