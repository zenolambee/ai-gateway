PORT=3000
NODE_ENV=development
VERSION=1.0.0
MODELS_LIST=[{"id":"deepseek-v4-flash","object":"model"}]
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=your-api-key-here
AI_MODEL=deepseek-v4-flash

# Provider Manager
# Directory containing provider JSON config files (defaults to config/providers)
PROVIDERS_CONFIG_DIR=config/providers

# API keys referenced by provider configs via ${VAR} placeholders
DEEPSEEK_API_KEY=your-deepseek-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
TOKENFAUCET_API_KEY=your-tokenfaucet-api-key-here
DATABRICKS_TOKEN=your-databricks-token-here
NVIDIA_API_KEY=your-nvidia-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Gateway Authentication
# When API keys are configured, every endpoint except /, /health, /ready
# requires a valid Bearer token. When no keys are configured, the gateway
# runs in open mode (no auth).
#
# Option 1: JSON file (see config/apiKeys.example.json)
# Copy it to config/apiKeys.json and edit:
#   cp config/apiKeys.example.json config/apiKeys.json
# API_KEYS_CONFIG_FILE=config/apiKeys.json
#
# Option 2: Environment variable (JSON array or comma-separated)
# GATEWAY_API_KEYS=["sk-my-key-1","sk-my-key-2"]
# GATEWAY_API_KEYS=sk-my-key-1,sk-my-key-2

# Rate Limiting & Quota Management
# When disabled (default), no rate limiting is applied.
# Copy config/rateLimit.example.json to config/rateLimit.json and edit:
#   cp config/rateLimit.example.json config/rateLimit.json
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_ALGORITHM=token_bucket
# RATE_LIMIT_GLOBAL_RPM=1000
# RATE_LIMIT_GLOBAL_BURST=100
# RATE_LIMIT_GLOBAL_CONCURRENT=50
# RATE_LIMIT_PER_KEY_RPM=100
# RATE_LIMIT_PER_KEY_BURST=20
# RATE_LIMIT_PER_KEY_CONCURRENT=10
# RATE_LIMIT_PER_KEY_DAILY_REQUESTS=10000
# RATE_LIMIT_PER_KEY_DAILY_TOKENS=1000000
# RATE_LIMIT_PER_KEY_MONTHLY_TOKENS=30000000
# RATE_LIMIT_PER_PROVIDER_RPM=500
# RATE_LIMIT_PER_PROVIDER_BURST=50
# RATE_LIMIT_PER_PROVIDER_CONCURRENT=20
# RATE_LIMIT_PER_MODEL_RPM=200
# RATE_LIMIT_PER_MODEL_BURST=20
